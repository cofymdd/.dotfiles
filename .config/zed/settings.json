{
	/* General: */
	"auto_update_extensions": {
		"one-black-theme": false,
		"wakatime": false,
		"nix": false
	},
	"use_system_path_prompts": false,
	"use_system_prompts": false,
	"restore_on_startup": "last_workspace",
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"auto_update": false,

	// Appearance
	"theme": "One Black",

	/* Keymap */
	"base_keymap": "Cursor",

	/* Editor: */
	"tab_size": 3,
	"hard_tabs": true,

	/* Languages & Tools: */
	/* Search & Files: */
	/* Windows & Layout: */

	/* Panels: */
	"project_panel": {
		"dock": "right"
	},

	/* Debugger: */
	/* Terminal: */
	/* Version Control: */
	/* Collaboration: */

	/* Ai */
	"agent": {
		"dock": "left",
		"play_sound_when_agent_done": true,
		"always_allow_tool_actions": true,
		"default_profile": "write",
		"default_model": {
			"provider": "copilot_chat",
			"model": "gpt-5"
		},
		"model_parameters": []
	},
	"features": {
		"edit_prediction_provider": "copilot"
	}

	/* Network: */
}
